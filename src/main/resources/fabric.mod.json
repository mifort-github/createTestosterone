{
  "schemaVersion": 1,
  "id": "testosterone",
  "version": "${version}",
  "name": "Create: Testosterone",
  "description": "An Addon for Create: Estrogen that adds usable testosterone, along with new items and more! \nCredits: spGrace, lillphildo, DakotaPride, ChisetteArt, whatchacallits, Falkory, Mayaqq",
  "authors": [
    "mifort, JonMyDude"
  ],
  "license": "GPL-3.0-only",
  "icon": "icon.png",
